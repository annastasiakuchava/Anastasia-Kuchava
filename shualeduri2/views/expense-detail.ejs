<%- include('partials/header') %>

<h2>დეტალები</h2>

<form id="updateForm">
    <input type="text" id="title" value="<%= expense.title %>" required>
    <input type="number" id="amount" value="<%= expense.amount %>" required>
    <input type="text" id="category" value="<%= expense.category %>" required>
    <button type="submit">განახლება</button>
</form>

<script>
    document.getElementById('updateForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = "<%= expense.id %>";
        const data = {
            title: document.getElementById('title').value,
            amount: document.getElementById('amount').value,
            category: document.getElementById('category').value,
        };

        const res = await fetch(`/api/expenses/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if(res.ok) {
            window.location.href = '/';
        }
    });
</script>

<%- include('partials/footer') %>